# Copy to .env and fill in. .env is gitignored; never commit it, and never put
# any of this under vr/ — Vite reads .env from its own root and exposes
# VITE_-prefixed values to the browser bundle.

# Speech to text for the headset (gate/voice.py). Without it /voice/ask
# returns 503 and the "Hold to ask" button stays greyed out.
OPENAI_API_KEY=

# Transcription model on the OpenAI audio route. Default: whisper-1
# WHISPER_MODEL=whisper-1

# Where the agent lab bridge is listening. Default: http://127.0.0.1:8010
# BRIDGE_URL=http://127.0.0.1:8010

# Which lab answers the headset: live (real orchestrator) or mock (bridge simulator). Default: live
# LAB_MODE=live
